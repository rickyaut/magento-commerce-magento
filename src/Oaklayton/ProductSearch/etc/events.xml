<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="catalog_product_save_after">
        <observer name="oaklayton_productsearch_ingest"
                  instance="Oaklayton\ProductSearch\Observer\ProductSaveObserver"/>
    </event>
    <event name="catalog_product_delete_after">
        <observer name="oaklayton_productsearch_delete"
                  instance="Oaklayton\ProductSearch\Observer\ProductDeleteObserver"/>
    </event>
</config>
