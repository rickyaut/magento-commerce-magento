<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="adminsso_token" resource="default" engine="innodb" comment="Admin SSO one-time tokens">
        <column xsi:type="varchar" name="token" length="64" nullable="false" comment="One-time SSO token"/>
        <column xsi:type="int" name="user_id" unsigned="true" nullable="false" comment="Admin user ID"/>
        <column xsi:type="int" name="expires_at" unsigned="true" nullable="false" comment="Unix timestamp expiry"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="token"/>
        </constraint>
    </table>
</schema>
